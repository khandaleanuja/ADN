@model IEnumerable<EFCoreCRUD.Models.Student>

<h2>Students List</h2>

<a href="/Students/Create">Add Student</a>

<table border="1">
    <tr>
        <th>Name</th>
        <th>Course</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Course</td>
            <td>
                <a href="/Students/Edit/@item.Id">Edit</a> |
                <a href="/Students/Delete/@item.Id">Delete</a>
            </td>
        </tr>
    }
</table>