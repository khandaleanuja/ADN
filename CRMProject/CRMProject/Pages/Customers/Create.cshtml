@page
@model YourProjectNamespace.Pages.Customers.Create
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">

            <h2 class="mb-4">New Customer</h2>

            <form method="post">

                <!-- Name -->
                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Name*</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control" asp-for="name" />
                        <span asp-validation-for="name" class="text-danger"></span>
                    </div>
                </div>

                <!-- Email -->
                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Email*</label>
                    <div class="col-sm-8">
                        <input type="email" class="form-control" asp-for="email" />
                        <span asp-validation-for="email" class="text-danger"></span>
                    </div>
                </div>

                <!-- Phone -->
                <div class="row mb-3">
                    <label class="col-sm-4 col-form-label">Phone*</label>
                    <div class="col-sm-8">
                        <input type="text" class="form-control" asp-for="phone" />
                        <span asp-validation-for="phone" class="text-danger"></span>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="row">
                    <div class="col-sm-4 offset-sm-4 d-grid">
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>

                    <div class="col-sm-4 d-grid">
                        <a asp-page="/Customers/Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}