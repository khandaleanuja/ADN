@page
@model CRMProject.Pages.Customers.Index
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Customers</h2>
        <a asp-page="/Customers/Create" class="btn btn-success">
            + Create New Customer
        </a>
    </div>

    <!-- Table -->
    <table class="table table-bordered table-striped text-center">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.listCustomers.Count == 0)
            {
                <tr>
                    <td colspan="5">No customers found</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.listCustomers)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>
                        <td>
                           <a asp-page="/Customers/Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                            <a asp-page="/Customers/Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div>